# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database
DATABASE_URL=postgres://finances:finances@localhost:5432/finances?sslmode=disable
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=finances
DATABASE_PASSWORD=finances
DATABASE_NAME=finances
DATABASE_SSLMODE=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_ACCESS_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=finances
MINIO_USE_SSL=false

# Asynq
ASYNC_REDIS_URL=redis://localhost:6379/1

# Email / Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no.reply@rojastudio.xyz
REPORT_NOTIFICATION_EMAIL=

# App
APP_NAME=Finances API
APP_ENV=development
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=*
