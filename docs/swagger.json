        "responses": {
          "200": { "description": "Account updated" }
        }
      },
      "delete": {
        "summary": "Delete account",
        "tags": ["Accounts"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
