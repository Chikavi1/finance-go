              "schema": {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "example": {
                  "currency": "USD",
                  "locale": "en-US",
                  "theme": "dark"
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Settings updated" }
        }
      }
