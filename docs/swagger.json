            "description": "Dashboard data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total_balance": { "type": "number" },
                    "monthly_income": { "type": "number" },
                    "monthly_expenses": { "type": "number" },
                    "recent_transactions": { "type": "array" },
                    "budgets": { "type": "array" },
                    "active_debts_total": { "type": "number" },
                    "active_debt_count": { "type": "integer" }
